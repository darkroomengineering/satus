{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@/"],
    "ignoreCase": true,
    "sortSideEffects": false
  },
  "sortTailwindcss": {
    "stylesheet": "./lib/styles/css/index.css",
    "functions": ["cn", "clsx"]
  },
  "sortPackageJson": {
    "sortScripts": false
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "dist/**",
    "public/**",
    ".vercel/**",
    "bun.lock",
    "lib/styles/css/tailwind.css",
    "lib/styles/css/root.css",
    "lib/integrations/sanity/sanity.types.ts",
    "CHANGELOG.md"
  ]
}
