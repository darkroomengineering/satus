{
  "name": "@darkroom.engineering/satus",
  "version": "3.0.0",
  "description": "Next.js 16 starter by darkroom.engineering — React 19, TypeScript strict, Tailwind v4, Zod validation, and production-ready integrations",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "bun ./lib/scripts/dev.ts",
    "dev:https": "bun ./lib/scripts/dev.ts --https",
    "build": "bun run setup:styles && next build",
    "start": "next start",
    "preview": "bun run build && next start",
    "prepare": "bun ./lib/scripts/prepare.ts",
    "check": "oxlint --report-unused-disable-directives --max-warnings=0 && oxfmt --check && bun run lint:types && bun run ensure:typegen && bun node_modules/typescript/bin/tsc --noEmit && bun test --parallel && bun run test:oxlint-plugin && bun run manifest:check && bun run check:assets && bun run check:disables",
    "clean": "rm -rf .next node_modules/.cache",
    "lint": "oxlint --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "lint:types": "oxlint --type-aware --max-warnings=0",
    "format": "oxfmt",
    "ensure:typegen": "test -f next-env.d.ts && test -f .next/types/routes.d.ts && test -f .next/types/root-params.d.ts || next typegen",
    "typecheck": "bun run ensure:typegen && bun node_modules/typescript/bin/tsc --noEmit",
    "typecheck:watch": "bun run ensure:typegen && bun node_modules/typescript/bin/tsc --noEmit --watch",
    "deslop": "deslop",
    "analyze": "ANALYZE=true bun run build",
    "analyze:experimental": "next experimental-analyze",
    "dev:inspect": "bun ./lib/scripts/dev.ts --inspect",
    "lighthouse": "bunx @unlighthouse/cli --site http://localhost:3000",
    "bench:nav": "bun ./lib/scripts/bench-navigation.ts",
    "bench:rerender": "bun ./lib/scripts/bench-rerender.ts",
    "setup:project": "bun ./lib/scripts/setup-project.ts",
    "test": "bun test --parallel",
    "test:e2e": "playwright test",
    "test:oxlint-plugin": "for f in tools/oxlint/*/rules/*.ruletest.ts; do node $f || exit 1; done",
    "test:setup": "bun test lib/scripts/setup-project.test.ts",
    "doctor": "bun ./lib/scripts/doctor.ts",
    "env:setup": "bun ./lib/scripts/env-setup.ts",
    "contrast:accept": "bun ./lib/styles/scripts/contrast-accept.ts",
    "setup:styles": "bun ./lib/styles/scripts/setup-styles.ts",
    "generate:manifest": "bun ./lib/scripts/generate-manifest.ts",
    "manifest:check": "bun ./lib/scripts/generate-manifest.ts --check",
    "check:assets": "bun ./lib/scripts/check-assets.ts",
    "check:disables": "bun ./lib/scripts/check-lint-disables.ts",
    "handoff": "bun ./lib/scripts/prepare-handoff.ts",
    "sanity:extract": "cd lib/integrations/sanity && dotenvx run -f ../../../.env.local -f ../../../.env.development -f ../../../.env --ignore=MISSING_ENV_FILE --strict -e SANITY_STUDIO_PROJECT_ID=extract-only -- sanity schema extract --force",
    "sanity:typegen": "cd lib/integrations/sanity && dotenvx run -f ../../../.env.local -f ../../../.env.development -f ../../../.env --ignore=MISSING_ENV_FILE --strict -- sanity typegen generate",
    "sanity:mcp": "bun ./lib/scripts/copy-sanity-mcp.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "@dotenvx/next-env": "^2.4.12",
    "@portabletext/react": "^8.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^7.28.0",
    "@sanity/image-url": "^2.1.1",
    "@theatre/core": "^0.7.2",
    "@vercel/analytics": "^2.0.1",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "hamo": "^1.0.3",
    "lenis": "2.0.0-dev.5",
    "next": "16.4.3",
    "next-sanity": "^13.3.4",
    "postprocessing": "^6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tempus": "^1.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@clack/prompts": "^1.8.1",
    "@csstools/postcss-global-data": "^4.0.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@next/bundle-analyzer": "16.4.2",
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "1.64.1",
    "@sanity/icons": "^5.2.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@theatre/studio": "^0.7.2",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "colorjs.io": "^0.7.1",
    "deslop-cli": "^0.9.12",
    "lefthook": "^2.2.1",
    "oxc-parser": "0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.31",
    "postcss-functions": "^4.0.2",
    "postcss-preset-env": "^11.6.1",
    "react-scan": "^0.5.7",
    "sanity": "^6.20.0",
    "sanity-plugin-link-field": "^2.1.0",
    "styled-components": "^6.6.0",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "undici": "7.30.1"
    },
    "@next/env": "npm:@dotenvx/next-env",
    "@vercel/frameworks": {
      "js-yaml": "3.15.2"
    },
    "playwright-core": "1.64.1",
    "smol-toml": "1.9.1",
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "oxlint",
    "oxfmt",
    "@swc/core",
    "@tailwindcss/oxide",
    "esbuild",
    "lefthook",
    "sharp"
  ]
}
